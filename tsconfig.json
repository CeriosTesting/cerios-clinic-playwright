{
	"compilerOptions": {
		"target": "ES2019",
		"module": "commonjs",
		"noEmit": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true,
		"strictPropertyInitialization": false,
		"types": [
			"node"
		],
		"paths": {}
	},
	"include": [
		"./*.ts",
		"./src/**/*.ts",
		"./tests/**/*.ts",
		"./pageObjects/**/*.ts",
		"./enums/**/*.ts",
		"./.auth/**/*.ts",
		"./configuration/**/*.ts"
	]
}